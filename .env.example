# SkillBridge Frontend Environment Variables (.env)
#
# SINGLE-SERVICE PRODUCTION DEPLOYMENT:
# In production on Render, the frontend is built into `dist/` and served directly by the Express backend.
# The API client automatically resolves API calls to relative `/api`, so NO VITE_API_URL is needed in production.
#
# LOCAL DEVELOPMENT:
# Optional: defaults to http://localhost:5000/api if left unset.
VITE_API_URL=http://localhost:5000/api
