NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://skillbridge-frontend.onrender.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=SkillBridge <notifications@skillbridge.io>
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
INITIAL_ADMIN_EMAIL=admin@skillbridge.io
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_min_10_chars
