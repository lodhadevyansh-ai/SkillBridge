# SkillBridge Backend Environment Variables (.env)
#
# Server Runtime
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Single-Service Deployment note:
# In single-service production deployment on Render, the frontend and API run on the exact same domain.
# FRONTEND_URL is optional; set it only if you want an explicit CORS origin whitelist for external clients.
# FRONTEND_URL=https://skillbridge-frontend.onrender.com

# Email Notifications (Resend - Optional in dev, recommended in production)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=SkillBridge <notifications@skillbridge.io>

# File / Resume Uploads (Cloudinary - Optional in dev, recommended in production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Bootstrap (Optional)
INITIAL_ADMIN_EMAIL=admin@skillbridge.io
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_min_10_chars
