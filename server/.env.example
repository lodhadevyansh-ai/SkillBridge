# Server Network & Environment
PORT=5000
NODE_ENV=production

# Security & JWT Authentication (minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend CORS Origin (Render Static Site URL)
FRONTEND_URL=https://skillbridge-frontend.onrender.com

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=SkillBridge <notifications@yourdomain.com>

# Cloudinary Storage for Resumes & Media
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
